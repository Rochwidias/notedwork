# notedwork Google integration — isi di .env.local (dev) / Vercel env (prod).
# JANGAN commit nilai asli. Semua key ini server-only.

# Google OAuth (console.cloud.google.com → Credentials → OAuth client Web)
GOOGLE_CLIENT_ID=your_google_client_id
GOOGLE_CLIENT_SECRET=your_google_client_secret

# Kunci enkripsi token (32 byte base64). Generate: openssl rand -base64 32
GOOGLE_TOKEN_KEY=your_32byte_base64_key

# Supabase khusus notedwork (boleh project yang sama dengan web, tabel beda)
SUPABASE_URL_NOTEDWORK=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY_NOTEDWORK=your_service_role_key

# Base URL app (tanpa trailing slash)
APP_URL=http://localhost:3000
